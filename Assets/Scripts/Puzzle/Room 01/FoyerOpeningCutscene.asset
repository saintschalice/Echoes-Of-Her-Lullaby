  m_Script: {fileID: 11500000, guid: 25c76e50a7b55064089d6c2fb46671aa, type: 3}
  m_Name: FoyerOpeningCutscene
  m_EditorClassIdentifier: Assembly-CSharp::VoiceOverCutsceneData
  voiceOverAudio: {fileID: 8300000, guid: 34f9bfada0de28448b1afb00d2c93fe3, type: 3}
  backgroundMusic: {fileID: 0}
  voiceoverVolume: 1
  musicVolume: 0.3
  lines:
  - fullText: "Twenty years. It\u2019s been twenty years since they closed the file.
      The murder of my Mother. The killer was never found. Case dismissed."
    sentences:
    - sentence: Twenty years.
      startTime: 0.459
      endTime: 0
      fadeInDuration: 0.3
    - sentence: "It\u2019s been twenty years since they closed the file."
      startTime: 1.84
      endTime: 0
      fadeInDuration: 0.3
    - sentence: The murder
      startTime: 4.729
      endTime: 0
      fadeInDuration: 0.3
    - sentence: of my Mother.
      startTime: 5.7
      endTime: 0
      fadeInDuration: 0.3
    - sentence: The killer was never found.
      startTime: 7.22
      endTime: 0
      fadeInDuration: 0.3
    - sentence: Case dismissed.
      startTime: 9.199
      endTime: 10.87
      fadeInDuration: 0.3
    fadeOutDuration: 0.5
    pauseAfterLine: 0
  - fullText: "Every night, it\u2019s the same vague memory. The vagueness is the
      lie. They told me I lost a mother. I believed them. I needed to believe them."
    sentences:
    - sentence: Every night,
      startTime: 11.569
      endTime: 0
      fadeInDuration: 0.3
    - sentence: "it\u2019s the same vague memory."
      startTime: 12.787
      endTime: 0
      fadeInDuration: 0.3
    - sentence: The vagueness is the lie.
      startTime: 15.164
      endTime: 0
      fadeInDuration: 0.3
    - sentence: They told me I lost a mother.
      startTime: 17.864
      endTime: 0
      fadeInDuration: 0.3
    - sentence: I believed them.
      startTime: 20.132
      endTime: 0
      fadeInDuration: 0.3
    - sentence: I needed to believe them.
      startTime: 21.394
      endTime: 23
      fadeInDuration: 0.3
    fadeOutDuration: 0.5
    pauseAfterLine: 0
  - fullText: But a detective stops listening to lies. I pieced the evidence back
      together. The suppressed police report. The forgotten neighbor interviews.
      The whispers in the dark corners of my mind.
    sentences:
    - sentence: But
      startTime: 31.138
      endTime: 0
      fadeInDuration: 0.3
    - sentence: a detective stops listening to lies.
      startTime: 31.855
      endTime: 0
      fadeInDuration: 0.3
    - sentence: I pieced the evidence back together.
      startTime: 34.735
      endTime: 0
      fadeInDuration: 0.3
    - sentence: The suppressed police report.
      startTime: 37.363
      endTime: 0
      fadeInDuration: 0.3
    - sentence: The forgotten neighbor interviews.
      startTime: 39.529
      endTime: 0
      fadeInDuration: 0.3
    - sentence: The whispers in the dark corners of my mind.
      startTime: 42.378
      endTime: 45
      fadeInDuration: 0.3
    fadeOutDuration: 0.5
    pauseAfterLine: 0
  - fullText: It all led to one point. One house the police stopped investigating
      too quickly. A house possibly even abandoned decades ago.
    sentences:
    - sentence: It all led to one point.
      startTime: 46.055
      endTime: 0
      fadeInDuration: 0.3
    - sentence: One house the police stopped investigating too quickly.
      startTime: 48.153
      endTime: 0
      fadeInDuration: 0.3
    - sentence: A house possibly even abandoned decades ago.
      startTime: 52.18
      endTime: 55
      fadeInDuration: 0.3
    fadeOutDuration: 0.5
    pauseAfterLine: 0
  - fullText: The police filed it under 'Unsolved Homicide.' I call it a cold case
      that finally led me home. My mother wasn't just lost to me. She was silenced,
      and the truth is locked inside these walls.
    sentences:
    - sentence: The police filed it under 'Unsolved Homicide.'
      startTime: 56.136
      endTime: 0
      fadeInDuration: 0.3
    - sentence: I call it a cold case that finally led me home.
      startTime: 59.674
      endTime: 0
      fadeInDuration: 0.3
    - sentence: My mother wasn't just lost to me.
      startTime: 63.991
      endTime: 0
      fadeInDuration: 0.3
    - sentence: She was silenced,
      startTime: 66.688
      endTime: 0
      fadeInDuration: 0.3
    - sentence: and the truth is locked inside these walls.
      startTime: 68.202
      endTime: 70
      fadeInDuration: 0.3
    fadeOutDuration: 0.5
    pauseAfterLine: 0
  - fullText: Justice is waiting.
    sentences:
    - sentence: Justice
      startTime: 71.857
      endTime: 0
      fadeInDuration: 0.3
    - sentence: is waiting.
      startTime: 72.961
      endTime: 74
      fadeInDuration: 0.3
    fadeOutDuration: 0.5
    pauseAfterLine: 0
  fadeDuration: 1.5
  sentenceFadeInDuration: 0.3
  backgroundColor: {r: 0, g: 0, b: 0, a: 1}
